# WDK: JSON-RPC provider for the EVM chain used by the wallet (Sepolia testnet default)
WDK_EVM_PROVIDER=https://sepolia.drpc.org

# WDK: Testnet USDt contract address on Sepolia
WDK_USDT_CONTRACT=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0

# QVAC clip scoring runs fully local — no API key exists or is needed.
# All settings below are optional tuning knobs.

# Max still frames sampled per clip (bounds vision-token use). Default 8.
QVAC_MAX_FRAMES=8

# Context window for the multimodal model. Default 4096.
QVAC_CTX_SIZE=4096

# Dev/offline only: set to 1 to bypass the local model and return a
# deterministic placeholder score (exercises the pipeline without a model
# download). Leave unset for real on-device inference.
# QVAC_MOCK_SCORING=1
