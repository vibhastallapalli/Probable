# WDK: JSON-RPC provider for the EVM chain used by the wallet (Sepolia testnet default)
WDK_EVM_PROVIDER=https://sepolia.drpc.org

# WDK: Testnet USDt contract address on Sepolia (Pimlico/Candide faucet-linked token).
# NOTE: this value is currently hardcoded in src/main/wallet.js as USDT_SEPOLIA and is
# not read from the environment — update it there if you need to change the address.
WDK_USDT_CONTRACT=0xd077a400968890eacc75cdc901f0356c943e4fdb

# QVAC clip scoring runs fully local — no API key exists or is needed.
# All settings below are optional tuning knobs.

# Max still frames sampled per clip (bounds vision-token use). Default 16.
QVAC_MAX_FRAMES=8

# Context window override for the multimodal model. LEAVE UNSET normally:
# the code picks a per-model default (16384 for Qwen3-VL, whose image token
# cost scales with resolution; 8192 for the SmolVLM2 fallbacks). A value here
# overrides BOTH — setting it low (e.g. the old 4096) makes Qwen3-VL fail
# with CONTEXT_OVERFLOW on a normal 8-frame pass.
# QVAC_CTX_SIZE=16384

# Dev/offline only: set to 1 to bypass the local model and return a
# deterministic placeholder score (exercises the pipeline without a model
# download). Leave unset for real on-device inference.
# QVAC_MOCK_SCORING=1
