{
  "name": "probable",
  "version": "0.1.0",
  "private": true,
  "description": "An on device AI predictor with a self custodial wallet for backing your calls on football outcomes.",
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "node scripts/fix-electron-binary.js",
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "@qvac/sdk": "^0.14.0",
    "@tetherto/wdk": "^1.0.0-beta.12",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.14",
    "b4a": "^1.8.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "playwright-core": "^1.61.1",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
